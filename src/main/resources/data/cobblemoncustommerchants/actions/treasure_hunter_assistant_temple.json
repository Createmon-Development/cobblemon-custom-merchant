{
  "description": "Treasure Hunter's Assistant dialogue at the temple for Crystal Ascendancy quest",
  "dialogue_lines": [
    {
      "id": "has_tablet_celebrate",
      "type": "dialogue",
      "speaker": "Treasure Hunter's Assistant",
      "text": "You actually did it! I thought I'd never see you again.",
      "conditions": [
        {"type": "has_item", "item": "skyscobblemonitems:runic_cipher_tablet"}
      ],
      "priority": 100,
      "repeatable": false,
      "actions": [
        {"type": "play_sound", "sound": "minecraft:entity.player.levelup"}
      ],
      "next": "return_home_prompt"
    },
    {
      "id": "tablet_check",
      "type": "dialogue",
      "text": "",
      "conditions": [
        {"type": "has_item", "item": "skyscobblemonitems:runic_cipher_tablet"}
      ],
      "priority": 90,
      "repeatable": true,
      "entry_point": true,
      "next": "return_home_prompt"
    },
    {
      "id": "return_home_prompt",
      "type": "dialogue",
      "speaker": "Treasure Hunter's Assistant",
      "text": "It's time for you to return home. Bring this tablet to the Treasure Hunter in his studies.",
      "entry_point": false,
      "branches": [
        {
          "conditions": [{"type": "has_pokemon_move", "move": "teleport"}],
          "next": "return_has_teleport"
        }
      ],
      "default": "return_no_teleport"
    },
    {
      "id": "return_has_teleport",
      "type": "dialogue",
      "text": "Lovely, you brought a pokemon with Teleport with you. They'll help you get home in a jiffy!",
      "entry_point": false,
      "repeatable": true,
      "actions": [
        {"type": "teleport_option", "text": "[Teleport to Spawn]", "hover_text": "Click to teleport back to the Spawn", "destination": {"x": 22 , "y": 158 , "z": -9, "dimension": "minecraft:overworld"}}
      ],
      "end": true
    },
    {
      "id": "return_no_teleport",
      "type": "dialogue",
      "text": "It's a long journey back. Good luck, traveler!",
      "entry_point": false,
      "repeatable": true,
      "end": true
    },
    {
      "id": "greeting",
      "type": "dialogue",
      "speaker": "Treasure Hunter's Assistant",
      "text": "You made it! Long trek eh?",
      "priority": 50,
      "repeatable": false,
      "entry_point": true,
      "return_line": "return_router",
      "next": "spawn_warning"
    },
    {
      "id": "return_router",
      "type": "dialogue",
      "text": "",
      "entry_point": false,
      "branches": [
        {
          "conditions": [{"type": "has_item", "item": "skyscobblemonitems:runic_cipher_tablet"}],
          "next": "return_home_prompt"
        }
      ],
      "default": "dive_check"
    },
    {
      "id": "spawn_warning",
      "type": "dialogue",
      "text": "That temple is messy business, you may want to set your spawn somewhere in case you end up sleeping with the fishes.",
      "entry_point": false,
      "branches": [
        {
          "conditions": [{"type": "has_pokemon_move", "move": "dive"}],
          "next": "has_dive"
        }
      ],
      "default": "no_dive"
    },
    {
      "id": "dive_check",
      "type": "dialogue",
      "text": "",
      "entry_point": false,
      "branches": [
        {
          "conditions": [{"type": "has_pokemon_move", "move": "dive"}],
          "next": "has_dive"
        }
      ],
      "default": "no_dive"
    },
    {
      "id": "no_dive",
      "type": "dialogue",
      "text": "Bold of you to brave the temple without the help of your Pokemon. To each their own, best of luck!",
      "entry_point": false,
      "repeatable": true,
      "end": true
    },
    {
      "id": "has_dive",
      "type": "dialogue",
      "text": "It looks like you're all set to face the temple! Your pokemon will be helping you out.",
      "entry_point": false,
      "repeatable": true,
      "actions": [
        {"type": "apply_effect", "effect": "minecraft:water_breathing", "duration": 36000, "amplifier": 0},
        {"type": "play_sound", "sound": "minecraft:entity.player.levelup"}
      ],
      "end": true
    }
  ]
}
